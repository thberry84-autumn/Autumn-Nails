{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autumn-nails-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "routes": [
    { "pattern": "studio.autumnnails.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autumn-nails-booking",
      "database_id": "b89756f2-4282-4af0-908a-095b130f5f97"
    }
  ]
}
