{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autumn-nails-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
