{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autumn-nails-upload",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "autumn-nails-images"
    }
  ],
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  }
}
